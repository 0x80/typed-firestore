{
  "name": "typed-firestore",
  "version": "0.0.0",
  "private": true,
  "description": "Typed Firestore libraries for server, React and React Native",
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types --continue",
    "check-lint": "oxlint -c .oxlintrc.json --import-plugin --type-aware",
    "check-format": "oxfmt --check",
    "format": "oxfmt",
    "test": "turbo test --continue -- --watch false",
    "clean": "turbo clean",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "semver": "^7.8.5",
    "turbo": "^2.10.8",
    "typescript": "7.0.2",
    "vitepress": "^1.6.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint -c .oxlintrc.json --import-plugin --type-aware"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs})": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "pnpm@10.6.5"
}
