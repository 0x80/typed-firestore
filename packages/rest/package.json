{
  "name": "@typed-firestore/rest",
  "version": "0.1.0",
  "description": "Elegant, typed abstractions for Firestore on any runtime with fetch and Web Crypto",
  "keywords": [
    "bun",
    "cloudflare-workers",
    "deno",
    "edge",
    "firestore",
    "rest",
    "typed",
    "typed-firestore",
    "typescript",
    "workers"
  ],
  "license": "Apache-2.0",
  "author": "Thijs Koerselman",
  "repository": {
    "type": "git",
    "url": "https://github.com/0x80/typed-firestore",
    "directory": "packages/rest"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "tsdown",
    "clean": "del-cli dist tsconfig.tsbuildinfo",
    "test": "vitest run"
  },
  "devDependencies": {
    "@codecompose/typescript-config": "^5.1.0",
    "del-cli": "^7.0.0",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  }
}
