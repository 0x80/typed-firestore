{
  /**
   * The isomorphic preset targets any web-standards runtime, which is exactly
   * what this package needs: fetch, URLSearchParams, TextEncoder, atob/btoa and
   * crypto.subtle, without the Node or Workers specific globals.
   *
   * It brings in the DOM lib to get there, which also declares browser-only
   * globals such as document and localStorage. Those are absent on workerd,
   * Deno and Node, so nothing here may use them.
   */
  "extends": "@codecompose/typescript-config/library-isomorphic"
}
